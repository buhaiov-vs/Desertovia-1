# Copy to deploy/.env and fill in. deploy/.env is ignored by git.

# Public host name. Caddy obtains an HTTPS certificate for it automatically.
# Server without a domain: 91-98-8-14.sslip.io
# Local run over plain HTTP: http://localhost
DESERTOD_DOMAIN=91-98-8-14.sslip.io

# Letters and digits only (it goes into a connection string). Generate with:
# -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 40 | ForEach-Object { [char]$_ })
POSTGRES_PASSWORD=

# Daily database dump. Time is UTC (HH:MM); pick it so the dump finishes before the
# Hetzner backup window, then the server snapshot carries the dumps as well.
# BACKUP_DIR is a folder on the server, relative to deploy/.
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30
BACKUP_DIR=./backups

# Signs login cookies. Keep it stable: changing it signs everyone out. Generate with:
# $bytes = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
DATA_PROTECTION_KEY=

# Production on any public server. Development enables name-only login (anyone can sign in as anyone)
# and seeds a demo village, so use it only for local runs.
DESERTOD_ENVIRONMENT=Production

# Real time of one daytime and one night together (hh:mm:ss). Each half draws its own weather.
# Changing it on a running world moves forecasts already made onto other days and nights.
DAY_LENGTH=04:00:00

# How long a new village is safe from beasts on hunts and night raids (d.hh:mm:ss). Undead called by the Governor come anyway.
PEACEFUL_TIME=1.00:00:00

# Login providers: leave empty to hide a provider.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
